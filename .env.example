# Puerto y red del servidor Express en EC2
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Configuración JWT (NUNCA subir secretos reales al repositorio)
JWT_SECRET=reemplazar_por_secreto_seguro_de_al_menos_32_caracteres_en_ec2
JWT_ISSUER=distribuidora-el-volcan-api
JWT_AUDIENCE=distribuidora-el-volcan-web
JWT_EXPIRES_IN_SECONDS=3600

# Costo de hash BCrypt (work factor recomendado por OWASP: 10 a 12)
BCRYPT_SALT_ROUNDS=10

# Conexión a PostgreSQL en Amazon RDS
# DB_MODE puede ser:
#   "auto"     -> conecta a PostgreSQL (RDS) si DB_HOST está definido; si no, usa persistencia en memoria con datos semilla para pruebas locales
#   "postgres" -> exige conexión activa a PostgreSQL (Amazon RDS)
#   "memory"   -> usa el motor en memoria con datos iniciales del catálogo (ideal para pruebas unitarias/integración)
DB_MODE=auto
DB_HOST=
DB_PORT=5432
DB_NAME=elvolcan_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=true
DB_POOL_MAX=10
